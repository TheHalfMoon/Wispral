{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://wispral.invalid/contracts/v1/consent_record.schema.json",
 "title": "Voice-asset consent record (CANDIDATE v1, revised after Core audit)",
 "description": "A projection over append-only consent_granted / consent_revoked provenance events: revocation is a new event, never an in-place edit. Binds a personal voice reference to an opaque subject, purpose, scope and validity. No personal display data is stored here. Revocation blocks new, queued, resumed and cached work; it cannot recall past exports. valid_until > valid_from is checked by the runtime runner; strictly increasing consent_epoch is enforced by the signed append-only consent ledger (packet ST-D03). Lifecycle fields (status, revoked_at) are an unsigned projection: every gate derives the current state from the latest signed ledger event for (consent_id, consent_epoch) and refuses any record whose projection disagrees with it.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "consent_id",
  "voice_id",
  "subject_ref",
  "relationship",
  "principal_scope_ref",
  "purposes",
  "products",
  "valid_from",
  "evidence_digest",
  "status",
  "consent_epoch",
  "watermark_required",
  "reference_artifact_digest",
  "speaker_match",
  "attestation"
 ],
 "properties": {
  "consent_id": {
   "type": "string",
   "minLength": 8,
   "maxLength": 128
  },
  "voice_id": {
   "type": "string",
   "minLength": 8,
   "maxLength": 128
  },
  "subject_ref": {
   "type": "string",
   "pattern": "^subj-[A-Za-z0-9_-]{6,64}$",
   "description": "Opaque reference; names and contact details live only in the product's local store."
  },
  "relationship": {
   "enum": [
    "self",
    "consenting_third_party",
    "licensed_voice_actor"
   ]
  },
  "principal_scope_ref": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128,
   "description": "Studio project owner or Klaint tenant."
  },
  "purposes": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "enum": [
     "personal",
     "commercial",
     "internal_evaluation"
    ]
   }
  },
  "products": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "enum": [
     "wisprstudio",
     "klaint"
    ]
   }
  },
  "allowed_engines": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 128
   }
  },
  "scope_note": {
   "type": "string",
   "maxLength": 512
  },
  "valid_from": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
  },
  "valid_until": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
  },
  "evidence_digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$",
   "description": "Digest of the consent statement recording or document."
  },
  "status": {
   "enum": [
    "active",
    "revoked",
    "expired"
   ]
  },
  "revoked_at": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
  },
  "consent_epoch": {
   "type": "integer",
   "minimum": 0
  },
  "watermark_required": {
   "type": "boolean"
  },
  "reference_artifact_digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$",
   "description": "Digest of the exact reference audio the consent covers; a mismatching reference is refused."
  },
  "speaker_match": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "method",
    "result"
   ],
   "properties": {
    "method": {
     "enum": [
      "speaker_verification_model",
      "human_review"
     ]
    },
    "result": {
     "enum": [
      "match",
      "no_match",
      "not_checked"
     ]
    },
    "evidence_digest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    }
   },
   "description": "Whether the speaker of the consent statement matches the reference audio."
  },
  "attestation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "issuer",
    "identity_check",
    "statement",
    "bound_fields_digest",
    "nonce",
    "issued_at",
    "signature"
   ],
   "description": "Authenticated consent. The issuer signs bound_fields_digest: the SHA-256 of the canonical JSON (sorted keys, no spaces, absent fields as null) of every record field except status, revoked_at, scope_note and display data, together with every attestation field except bound_fields_digest and signature. The covered fields are consent_id, subject_ref, voice_id, relationship, principal_scope_ref, purposes, products, allowed_engines, valid_from, valid_until, evidence_digest, consent_epoch, watermark_required, reference_artifact_digest, speaker_match, and the attestation's issuer, identity_check, statement, nonce and issued_at. Verifiers recompute the digest and verify the signature with the key named by issuer.key_id, which must equal signature.key_id. A speaker match alone never establishes consent.",
   "properties": {
    "issuer": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "key_id"
     ],
     "properties": {
      "kind": {
       "enum": [
        "studio_operator",
        "consent_service"
       ]
      },
      "key_id": {
       "type": "string",
       "pattern": "^[A-Za-z0-9:._-]{3,64}$"
      }
     },
     "description": "Issuer identity. The key_id must be listed in the pinned trusted-key registry (fixtures/trusted_keys.json for conformance; a signed, versioned registry in the product) with this exact kind. Operator keys use the op-key: namespace and consent-service keys the consent-svc: namespace; a label alone never authenticates an issuer."
    },
    "identity_check": {
     "enum": [
      "in_person_id_check",
      "live_video_id_check"
     ],
     "description": "Live identity checks only; the statement is captured in the same live session."
    },
    "statement": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "script_id",
      "transcript_match",
      "operator_confirmed",
      "live_capture",
      "challenge_digest"
     ],
     "properties": {
      "script_id": {
       "type": "string",
       "pattern": "^[a-z0-9-]{3,48}@[0-9]+$"
      },
      "transcript_match": {
       "enum": [
        "match",
        "mismatch"
       ]
      },
      "operator_confirmed": {
       "type": "boolean"
      },
      "live_capture": {
       "const": true,
       "description": "Recorded live in the consent flow, not imported."
      },
      "challenge_digest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$",
       "description": "Digest of a random challenge phrase shown only at capture time and required in the spoken statement (anti-replay, anti-splice)."
      }
     },
     "description": "The recorded consent statement says the versioned consent script (purposes and products included), checked by transcript and confirmed by a human operator."
    },
    "bound_fields_digest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonce": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{22,64}$",
     "description": "At least 128 bits of randomness, base64url."
    },
    "issued_at": {
     "type": "string",
     "format": "date-time",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "signature": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "alg",
      "key_id",
      "value"
     ],
     "properties": {
      "alg": {
       "const": "ed25519"
      },
      "key_id": {
       "type": "string",
       "pattern": "^[A-Za-z0-9:._-]{3,64}$"
      },
      "value": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{86}$",
       "description": "Detached Ed25519 signature, base64url without padding."
      }
     }
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "const": "revoked"
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "required": [
     "revoked_at"
    ]
   }
  },
  {
   "if": {
    "required": [
     "revoked_at"
    ]
   },
   "then": {
    "properties": {
     "status": {
      "const": "revoked"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "expired"
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "required": [
     "valid_until"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "relationship": {
      "const": "consenting_third_party"
     }
    },
    "required": [
     "relationship"
    ]
   },
   "then": {
    "properties": {
     "watermark_required": {
      "const": true
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "active"
     },
     "relationship": {
      "enum": [
       "self",
       "consenting_third_party"
      ]
     }
    },
    "required": [
     "status",
     "relationship"
    ]
   },
   "then": {
    "properties": {
     "speaker_match": {
      "properties": {
       "result": {
        "const": "match"
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "active"
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "properties": {
     "attestation": {
      "properties": {
       "statement": {
        "properties": {
         "transcript_match": {
          "const": "match"
         },
         "operator_confirmed": {
          "const": true
         }
        }
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "anyOf": [
     {
      "properties": {
       "purposes": {
        "contains": {
         "const": "commercial"
        }
       }
      },
      "required": [
       "purposes"
      ]
     },
     {
      "properties": {
       "relationship": {
        "enum": [
         "consenting_third_party",
         "licensed_voice_actor"
        ]
       }
      },
      "required": [
       "relationship"
      ]
     }
    ]
   },
   "then": {
    "properties": {
     "watermark_required": {
      "const": true
     },
     "attestation": {
      "properties": {
       "issuer": {
        "properties": {
         "kind": {
          "const": "consent_service"
         }
        }
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "attestation": {
      "properties": {
       "issuer": {
        "properties": {
         "kind": {
          "const": "consent_service"
         }
        }
       }
      }
     }
    },
    "required": [
     "attestation"
    ]
   },
   "then": {
    "properties": {
     "attestation": {
      "properties": {
       "issuer": {
        "properties": {
         "key_id": {
          "pattern": "^consent-svc:[A-Za-z0-9._-]{1,48}$"
         }
        }
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "attestation": {
      "properties": {
       "issuer": {
        "properties": {
         "kind": {
          "const": "studio_operator"
         }
        }
       }
      }
     }
    },
    "required": [
     "attestation"
    ]
   },
   "then": {
    "properties": {
     "attestation": {
      "properties": {
       "issuer": {
        "properties": {
         "key_id": {
          "pattern": "^op-key:[A-Za-z0-9._-]{1,48}$"
         }
        }
       }
      }
     }
    }
   }
  }
 ]
}
