      "properties": {
        "tool": {"const": "FFmpeg"},
        "version": {"const": "9.0.1"},
        "source_repository": {"const": "FFmpeg/FFmpeg"},
        "source_tag": {"const": "n9.0.1"},
        "tag_object": {"const": "501bb49457b9dfb25d6a208832e0a6e6cd53108d"},
        "source_commit": {"const": "bf1b838f2ab88b4f8fd83443325c782ea0e0f7fa"},
        "tag_signature_verified_upstream": {"const": true},
        "attempt_binary_sha256_required": {"const": true},
        "attempt_version_output_sha256_required": {"const": true},
        "canonical_format": {"const": "PCM_WAV"},
        "sample_rate_hz": {"const": 16000},
        "channels": {"const": 1},
        "sample_format": {"const": "PCM_S16LE"},
        "denoising": {"const": "NONE"},
        "loudness_normalization": {"const": "NONE"},
        "semantic_silence_trim": {"const": "NONE"},
        "command_template": {"const": "ffmpeg -nostdin -hide_banner -loglevel error -i INPUT -map_metadata -1 -vn -sn -dn -ac 1 -ar 16000 -c:a pcm_s16le OUTPUT.wav"},
        "canonical_output_sha256_required": {"const": true},
        "float32_adapter_rule": {"type": "string", "minLength": 1},
        "feed_chunk_ms": {"const": 500},
        "feed_chunk_samples": {"const": 8000},
        "finalization_zero_pad_ms": {"const": 660},
        "finalization_zero_pad_samples": {"const": 10560},
        "timing_markers": {"const": ["speech_audio_start", "speech_audio_end", "feed_end_after_zero_pad"]}
      }
    },
    "common_c0": {
      "const": {
        "language": "en",
        "device": "CPU_ONLY",
        "repository_context": "OFF",
        "test_specific_context": "OFF",
        "post_decode_entity_correction": "OFF",
        "external_language_model": "OFF",
        "candidate_specific_audio_transform": "OFF",
        "feed_chunk_ms": 500,
        "finalization_zero_pad_ms": 660
