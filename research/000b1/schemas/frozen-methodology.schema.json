      "type": "object",
      "additionalProperties": false,
      "required": ["moonshine", "whisper.cpp", "sherpa-onnx"],
      "properties": {
        "moonshine": {
          "type": "object",
          "required": ["runtime_revision", "keyterms", "context", "ort_providers", "vad_threshold", "transcription_interval_seconds", "word_timestamps"],
