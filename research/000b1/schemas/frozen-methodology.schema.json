{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheHalfMoon/Wispral/research/000b1/schemas/frozen-methodology.schema.json",
  "title": "Wispral 000B1 Frozen Methodology",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "canonical_wispral_base", "speaker_design", "preprocessing", "common_c0", "c0_by_family", "fairness_notes"],
  "properties": {
    "schema_version": {"const": "000b1-frozen-methodology-v1"},
    "contract_version": {"const": "000b1-contract-v1"},
    "canonical_wispral_base": {"const": "6b5696a6becc360948282712cc9339df9cb3a67c"},
    "speaker_design": {
      "type": "object",
      "required": ["total_human_speakers", "speaker_disjoint_splits", "speakers_by_split", "utterances_per_speaker", "planned_total_utterances", "planned_test_utterances", "max_primary_utterance_seconds", "minimum_test_microphone_environment_profiles", "cadence_requirement", "identity_minimization", "rationale"],
      "properties": {
        "total_human_speakers": {"const": 20},
        "speaker_disjoint_splits": {"const": true},
        "speakers_by_split": {
          "const": {"development": 4, "qualification": 4, "test": 12}
        },
        "utterances_per_speaker": {
          "const": {"developer_entity": 24, "general_collateral": 12}
        },
        "planned_total_utterances": {"const": 720},
        "planned_test_utterances": {
          "const": {"developer_entity": 288, "general_collateral": 144, "total": 432}
        },
        "max_primary_utterance_seconds": {"const": 12},
        "minimum_test_microphone_environment_profiles": {"minimum": 4},
        "cadence_requirement": {"type": "string", "minLength": 1},
        "identity_minimization": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "preprocessing": {
