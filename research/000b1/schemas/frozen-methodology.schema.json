        "whisper.cpp": {
          "type": "object",
          "required": ["runtime_revision", "threads", "initial_prompt", "prompt_carryover", "use_gpu", "flash_attention", "sampling"],
          "properties": {
            "runtime_revision": {"const": "371b5a7561823ab2bb32142d2751e35e7534727b"},
            "threads": {"const": 4},
            "initial_prompt": {"const": "OFF"},
            "prompt_carryover": {"const": "OFF"},
            "use_gpu": {"const": false},
            "flash_attention": {"const": false},
            "sampling": {"const": "GREEDY"}
          }
        },
        "sherpa-onnx": {
          "type": "object",
          "required": ["runtime_revision", "threads", "provider", "decoding_method", "lm", "hotwords_file", "modeling_unit", "bpe_vocab", "endpoint_detection"],
          "properties": {
            "runtime_revision": {"const": "917bed95c8e5c7c18aa4d69fea42e9ef8ef0a60e"},
            "threads": {"const": 4},
            "provider": {"const": "cpu"},
            "decoding_method": {"const": "greedy_search"},
            "lm": {"const": "OFF"},
            "hotwords_file": {"const": "OFF"},
            "modeling_unit": {"const": "OFF"},
            "bpe_vocab": {"const": "OFF"},
            "endpoint_detection": {"const": "OFF_PRESEGMENTED_INPUT_FINISHED"}
          }
        }
      }
    },
    "fairness_notes": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  }
}
