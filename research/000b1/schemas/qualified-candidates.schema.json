{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheHalfMoon/Wispral/research/000b1/schemas/qualified-candidates.schema.json",
  "title": "Wispral 000B1 Qualified Candidate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recorded_date", "canonical_wispral_base", "contract_version", "primary_test_decoding_performed", "comparative_ranking_present", "qualification_smoke", "tiers", "selection_rule", "families", "b2_entry_gates"],
  "properties": {
    "schema_version": {"const": "000b1-qualified-candidates-v1"},
    "recorded_date": {"type": "string", "format": "date"},
    "canonical_wispral_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_version": {"const": "000b1-contract-v1"},
    "primary_test_decoding_performed": {"const": false},
    "comparative_ranking_present": {"const": false},
    "qualification_smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "comparative"],
      "properties": {
        "status": {"const": "NOT_RUN_NOT_REQUIRED"},
        "comparative": {"const": false}
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["COMPACT", "BALANCED"],
      "properties": {
        "COMPACT": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_exclusive_bytes", "max_inclusive_bytes"],
          "properties": {
            "min_exclusive_bytes": {"const": 0},
            "max_inclusive_bytes": {"const": 167772160}
          }
        },
        "BALANCED": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_exclusive_bytes", "max_inclusive_bytes"],
          "properties": {
            "min_exclusive_bytes": {"const": 167772160},
            "max_inclusive_bytes": {"const": 536870912}
          }
        }
      }
    },
    "selection_rule": {"type": "string", "minLength": 1},
    "families": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["family", "runtime", "model_source", "configurations"],
        "properties": {
          "family": {"enum": ["moonshine", "whisper.cpp", "sherpa-onnx"]},
          "runtime": {
            "type": "object",
            "required": ["revision"],
            "properties": {"revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
          },
          "configurations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "tier", "status", "payload_total_bytes", "artifacts", "c0"],
              "properties": {
                "id": {"enum": ["moonshine-compact", "moonshine-balanced", "whispercpp-compact", "whispercpp-balanced", "sherpa-onnx-compact", "sherpa-onnx-balanced"]},
                "tier": {"enum": ["COMPACT", "BALANCED"]},
                "status": {"const": "QUALIFIED_PREREGISTERED"},
                "payload_total_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
                "artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["path", "size_bytes", "sha256", "sha256_status"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "size_bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                      "sha256_status": {"enum": ["PINNED", "PENDING_B2_MATERIALIZATION"]}
                    }
                  }
                },
                "c0": {"type": "object", "minProperties": 1}
              }
            }
          }
        }
      }
    },
    "b2_entry_gates": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}}
  }
}
