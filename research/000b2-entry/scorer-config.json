{
  "schema_version": "000b2-scorer-config-v1",
  "implementation_id": "wispral-000b2-deterministic-scorer-v1",
  "unicode_representation": "NFC",
  "entity_scoring": {
    "reference_order": "start_char,end_char,entity_id",
    "hypothesis_vocabulary_source": "FROZEN_ANNOTATION_EXACT_TEXT_AND_DISTRACTORS_SCORER_ONLY",
    "decoder_visibility": false,
    "match": "LITERAL_NFC_WITH_WORD_EDGE_GUARDS",
    "overlap_resolution": "LONGEST_THEN_EARLIEST_START_THEN_LEXICOGRAPHIC",
    "sequence_alignment": "UNIT_COST_LEVENSHTEIN",
    "tie_break": "MATCH_THEN_SUBSTITUTION_THEN_DELETION_THEN_INSERTION",
    "normalization": "DISABLED_EXACT_EQUALS_NORMALIZED",
    "required_annotation_normalization_allowed": false
  },
  "ordinary_wer": {
    "panels": ["GENERAL_COLLATERAL"],
    "unicode_representation": "NFC",
    "casefold": true,
    "punctuation_and_symbol_categories_to_space": ["P", "S"],
    "whitespace": "COLLAPSE_AND_SPLIT",
    "algorithm": "UNIT_COST_LEVENSHTEIN"
