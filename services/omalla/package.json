{
  "name": "omalla",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, agent-native voice AI and business automation platform",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "sdks/typescript"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node packages/server/dist/bin/serve.js",
    "dev": "node scripts/build.mjs && node packages/server/dist/bin/serve.js",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "audit:licenses": "node scripts/check-licenses.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "smoke:python": "node scripts/smoke-python.mjs",
    "test:python": "python -m unittest discover -s sdks/python/tests -t sdks/python",
    "verify": "npm run build && npm run typecheck && npm test && npm run audit:licenses && npm run check:docs",
    "openapi:check": "node scripts/run-tests.mjs tests/openapi.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
